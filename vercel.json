{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/index\\.php$", "dest": "/api/index.php" },
    { "src": "^/about\\.php$", "dest": "/api/about.php" },
    { "src": "^/writings\\.php$", "dest": "/api/writings.php" },
    { "src": "^/featured\\.php$", "dest": "/api/featured.php" },
    { "src": "^/submit\\.php$", "dest": "/api/submit.php" },
    { "src": "^/contact\\.php$", "dest": "/api/contact.php" },
    { "handle": "filesystem" }
  ]
}
